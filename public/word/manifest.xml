<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="TaskPaneApp">
  <Id>762eb57c-3a32-4929-856f-2bb41144b148</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Bluebookr</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Bluebookr"/>
  <Description DefaultValue="Review legal citation drafts and cite websites in Word."/>
  <IconUrl DefaultValue="https://bluebookr.onrender.com/word/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://bluebookr.onrender.com/word/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/reconsidering/bluebookr"/>
  <AppDomains><AppDomain>https://bluebookr.onrender.com</AppDomain></AppDomains>
  <Hosts><Host Name="Document"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="WordApi"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://bluebookr.onrender.com/word/taskpane.html"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.1"><bt:Set Name="WordApi"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="Document"><DesktopFormFactor>
      <FunctionFile resid="Commands.Url"/>
      <ExtensionPoint xsi:type="PrimaryCommandSurface"><CustomTab id="Bluebookr.Tab"><Group id="Bluebookr.Group">
        <Label resid="Group.Label"/>
        <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
        <Control xsi:type="Button" id="Bluebookr.Open">
          <Label resid="Button.Label"/><Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ShowTaskpane"><TaskpaneId>Bluebookr.Sidebar</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action>
        </Control>
      </Group><Label resid="Tab.Label"/></CustomTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://bluebookr.onrender.com/word/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://bluebookr.onrender.com/word/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://bluebookr.onrender.com/word/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Commands.Url" DefaultValue="https://bluebookr.onrender.com/word/commands.html"/><bt:Url id="Taskpane.Url" DefaultValue="https://bluebookr.onrender.com/word/taskpane.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Tab.Label" DefaultValue="Bluebookr"/><bt:String id="Group.Label" DefaultValue="Citations"/><bt:String id="Button.Label" DefaultValue="Open Bluebookr"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Description" DefaultValue="Review legal citations, cite URLs, and apply corrections in this document."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
